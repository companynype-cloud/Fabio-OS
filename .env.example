# ============================================================
# LIFE OS — VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commitar .env.local no repositório
# ============================================================

# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# ── Database (Prisma) ─────────────────────────────────────
# Supabase Dashboard → Settings → Database → Connection string → URI
# Usar Transaction pooler (porta 6543) para serverless
DATABASE_URL=postgresql://postgres.SEU_PROJECT_ID:SENHA@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection para migrations (porta 5432)
DIRECT_URL=postgresql://postgres.SEU_PROJECT_ID:SENHA@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── Better Auth ──────────────────────────────────────────
BETTER_AUTH_SECRET=gere-com-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# ── Redis (Upstash) ──────────────────────────────────────
REDIS_URL=redis://...
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# ── IA ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Storage (S3 / Supabase Storage) ──────────────────────
STORAGE_BUCKET=life-os
STORAGE_REGION=sa-east-1

# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
