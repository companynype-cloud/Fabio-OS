# ──────────────────────────────────────
# DATABASE — Supabase (sa-east-1)
# ──────────────────────────────────────
# Substitua [YOUR-PASSWORD] pela senha em: Supabase → Settings → Database → Database password
DATABASE_URL="postgresql://postgres.jtadgxxxhozsgigoejsd:[YOUR-PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.jtadgxxxhozsgigoejsd:[YOUR-PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# ──────────────────────────────────────
# BETTER AUTH
# ──────────────────────────────────────
